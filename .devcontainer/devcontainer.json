{
  "name": "SystemDesk V-ECU L1",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "./",
    "args": {
      "VARIANT": "ubuntu-22.04"
    }
  },
  "runArgs": [
    "--network=host"
  ],
  "remoteUser": "vscode",
  "postCreateCommand": "pip install -r requirements.txt || true",
  "features": {
    "ghcr.io/devcontainers/features/git:1": {},
    "ghcr.io/devcontainers/features/common-utils:2": {
      "installZsh": true
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cpptools",
        "ms-vscode.cmake-tools",
        "ms-python.python",
        "twxs.cmake",
        "eamodio.gitlens"
      ],
      "settings": {
        "cmake.configureOnOpen": false,
        "editor.formatOnSave": true,
        "files.associations": {
          "*.arxml": "xml"
        }
      }
    }
  },
  "onCreateCommand": "/bin/bash .devcontainer/scripts/setup-systemdesk.sh || true"
}
